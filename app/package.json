{
  "name": "mc-player-app",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for the OzoGo444 / Smeo444 dashboards, plus scheduled headless Claude review sessions",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0"
  },
  "author": "Walter",
  "build": {
    "appId": "com.walter.botdashboard",
    "productName": "Bot Dashboard",
    "executableName": "Bot Dashboard",
    "copyright": "Walter",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dashboard",
        "to": "dashboard",
        "filter": [
          "server.js",
          "public/**",
          "web/dist/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bot Dashboard",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
